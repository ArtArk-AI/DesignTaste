# Copy to a local, untracked .env file and fill only the providers you use.
# Azure language and image models require the configured proxy in your environment.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_PROXY=http://127.0.0.1:7895

# ArtArk connects directly; do not put proxy credentials in this file.
ARTARK_API_KEY=
ARTARK_ENDPOINT=
ARTARK_PROXY=

BAIDU_VOD_ACCESS_KEY_ID=
BAIDU_VOD_ACCESS_KEY_SECRET=
BAIDU_VOD_ENDPOINT=https://vod.bj.baidubce.com

VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
